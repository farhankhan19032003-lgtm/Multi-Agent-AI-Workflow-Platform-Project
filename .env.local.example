# Copy to api/.env  (run_local.sh / run_local.bat do this for you)
# Zero-setup single-user mode: no Supabase, no login, data stays in ./api/data
STORAGE=local
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE
# --- Or use Google Gemini (free tier): uncomment these and comment out the Claude lines above ---
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.8-flash
# LLM_FAST_MODEL=gemini-3.5-flash-lite
# GOOGLE_API_KEY=PASTE_GEMINI_KEY_HERE
# Optional: web search tool for agents (https://tavily.com)
TAVILY_API_KEY=
DATA_DIR=./data
