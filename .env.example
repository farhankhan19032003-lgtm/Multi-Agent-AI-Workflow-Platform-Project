# ---------- Supabase (Project Settings -> API) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server-side only. NEVER put it in a browser or n8n webhook response.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LLM ----------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# For OpenAI instead: LLM_PROVIDER=openai, LLM_MODEL=<model>, OPENAI_API_KEY=...
OPENAI_API_KEY=

# ---------- Research agent web search (https://tavily.com) ----------
TAVILY_API_KEY=

# ---------- Monitoring ----------
MLFLOW_EXPERIMENT=agent-factory
ENABLE_LLM_JUDGE=false

# ---------- SOP lookup with LlamaIndex (needs OPENAI_API_KEY for embeddings) ----------
ENABLE_KNOWLEDGE=false

# ---------- Alert thresholds ----------
DEFECT_ALERT_PCT=3.0
TARGET_ALERT_PCT=85.0

# ---------- n8n ----------
# Generate with: openssl rand -hex 24   (do not change after credentials are saved)
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/

# ---------- Production HTTPS (docker compose --profile prod up -d) ----------
API_DOMAIN=api.example.com
N8N_DOMAIN=n8n.example.com
# Set these three when serving n8n over HTTPS:
# N8N_PROTOCOL=https
# N8N_SECURE_COOKIE=true
# N8N_WEBHOOK_URL=https://n8n.example.com/

CORS_ORIGINS=*

# ---------- Chat UI (v2) ----------
# Supabase anon/public key (Project Settings -> API). Needed for browser login.
SUPABASE_ANON_KEY=
# LOCAL TRYOUT ONLY: skip login and use the demo tenant. NEVER true in production.
DEV_NO_AUTH=false

# ---------- v3 (Pro) ----------
# supabase = multi-user with login + workspaces (production). local = single user, no setup.
STORAGE=supabase
LLM_FAST_MODEL=claude-haiku-5-5
FREE_DAILY_MESSAGES=40
PRO_DAILY_MESSAGES=3000
MAX_UPLOAD_MB=50
