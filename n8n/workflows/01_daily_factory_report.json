{
  "name": "Agent Factory - Daily Factory Report",
  "nodes": [
    {
      "id": "everymorning700-639",
      "name": "Every Morning 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "runfactoryreportagents-7054",
      "name": "Run Factory Report Agents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/workflows/factory-report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-triggered-by",
              "value": "n8n"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ plant: 'Jaipur Plant', days: 7 }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Agent Factory API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "converttohtml-3569",
      "name": "Convert to HTML",
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1,
      "position": [
        520,
        120
      ],
      "parameters": {
        "mode": "markdownToHtml",
        "markdown": "={{ $json.output.markdown }}",
        "destinationKey": "html",
        "options": {}
      }
    },
    {
      "id": "emaildailyreport-171",
      "name": "Email Daily Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        780,
        120
      ],
      "parameters": {
        "fromEmail": "agent-factory@example.com",
        "toEmail": "ops-manager@example.com",
        "subject": "={{ $('Run Factory Report Agents').item.json.output.title }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:720px;margin:auto\">{{ $('Convert to HTML').item.json.html }}<hr><p style=\"color:#888;font-size:12px\">Generated by Agent Factory · run {{ $('Run Factory Report Agents').item.json.run_id }}</p></div>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE_ME",
          "name": "SMTP (Factory Reports)"
        }
      }
    },
    {
      "id": "anyalerts-1987",
      "name": "Any Alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "alerts-gt-0",
              "leftValue": "={{ $json.output.alerts.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "emailalert-3280",
      "name": "Email Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        780,
        300
      ],
      "parameters": {
        "fromEmail": "agent-factory@example.com",
        "toEmail": "ops-manager@example.com",
        "subject": "ALERT: production anomalies detected",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif\"><h2>Production alerts</h2><p>{{ $('Run Factory Report Agents').item.json.output.alerts.length }} anomaly(ies) detected.</p><pre>{{ JSON.stringify($('Run Factory Report Agents').item.json.output.alerts, null, 2) }}</pre></div>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE_ME",
          "name": "SMTP (Factory Reports)"
        }
      }
    }
  ],
  "connections": {
    "Every Morning 7:00": {
      "main": [
        [
          {
            "node": "Run Factory Report Agents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Factory Report Agents": {
      "main": [
        [
          {
            "node": "Convert to HTML",
            "type": "main",
            "index": 0
          },
          {
            "node": "Any Alerts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert to HTML": {
      "main": [
        [
          {
            "node": "Email Daily Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Alerts?": {
      "main": [
        [
          {
            "node": "Email Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "tags": []
}